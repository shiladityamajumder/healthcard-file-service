# =============================================================================
# HEALTHCARE FILE SERVICE ENVIRONMENT TEMPLATE
# =============================================================================
#
# Copy this file to `.env` and replace all development placeholders.
#
# Linux/macOS:
#   cp .env.example .env
#
# Windows:
#   copy .env.example .env
#
# Never commit `.env`, database credentials, AWS credentials, session tokens,
# internal-service secrets, presigned URLs, or production storage endpoints.
# Supply production secrets through the deployment platform's secret manager.
#
# Formatting rules:
# - Do not add spaces around "=".
# - Use true/false for booleans.
# - Comma-separated values must not be written as JSON lists.
# - UPLOAD_CATEGORY_POLICIES_JSON must be a valid JSON object on one line.
# - Percent-encode reserved characters in database URL credentials.
#
# The Compose stack starts only this API. PostgreSQL and S3-compatible storage
# must be supplied separately, and PostgreSQL must be migrated by the
# `healthcare_db` project before this service starts.


# =============================================================================
# APPLICATION AND HTTP SERVER
# =============================================================================

# Supported values:
#   development
#   test
#   staging
#   production
NODE_ENV=development

# HTTP port bound on 0.0.0.0 by the NestJS application.
# Valid range: 1 to 65535.
PORT=3000

# Service metadata exposed by Swagger and response envelopes.
PROJECT_NAME=Healthcare File Service
APP_VERSION=1.0.0

# Global API path is assembled as /{API_PREFIX}/{API_VERSION}.
# Do not include leading or trailing slashes.
API_PREFIX=api
API_VERSION=v1

# Maximum accepted JSON, URL-encoded, or multipart HTTP body size in bytes.
# Keep this greater than MAX_TOTAL_UPLOAD_SIZE_BYTES to allow multipart headers
# and other request fields. Default: 60 MiB.
MAX_HTTP_BODY_SIZE_BYTES=62914560


# =============================================================================
# API DOCUMENTATION AND CORS
# =============================================================================

# Enables Swagger UI at /docs and OpenAPI JSON at /openapi.json.
# Disable in production unless documentation is protected appropriately.
SWAGGER_ENABLED=true

# Enables browser cross-origin access. When false, CORS middleware is not added.
CORS_ENABLED=false

# Comma-separated list of exact browser origins. This is not a JSON list.
# Leave empty when CORS_ENABLED=false or when only trusted internal services call
# the API. Wildcards are not recommended for this credential-bearing service.
CORS_ORIGINS=

# Example:
# CORS_ENABLED=true
# CORS_ORIGINS=http://localhost:3001,https://app.example.com


# =============================================================================
# LOGGING
# =============================================================================

# Supported Pino levels:
# fatal, error, warn, info, debug, trace, or silent.
LOG_LEVEL=info

# Logs are emitted to stdout/stderr. Authorization, cookies, internal-service
# credentials, database URLs, signed URLs, and sensitive filenames are redacted
# by the application logger.


# =============================================================================
# POSTGRESQL
# =============================================================================

# Existing PostgreSQL database managed and migrated exclusively by
# `healthcare_db`. This service disables TypeORM synchronization, automatic
# migrations, and schema dropping.
#
# Supported URL schemes:
#   postgresql://
#   postgres://
#
# Direct host-run example:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/healthcare

# When the API runs in Docker, 127.0.0.1 points to the API container. Use a host
# that the container can reach, for example:
#
# DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/pharmacy
# DATABASE_URL=postgresql://file_app:change_me@postgres-service-name:5432/pharmacy

# Hosted PostgreSQL example (replace every placeholder):
#
# DATABASE_URL=postgresql://file_app:change_me@postgres.example.internal:5432/pharmacy

# URL-encode reserved characters used inside usernames or passwords.

# Enables TLS for the PostgreSQL connection.
DATABASE_SSL=false

# Validates the PostgreSQL server certificate when TLS is enabled.
# Keep true in production. Set false only for a controlled environment with an
# explicitly accepted certificate-verification risk.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Minimum idle connections retained per application process.
# Must be a positive integer and cannot exceed DATABASE_POOL_MAX.
DATABASE_POOL_MIN=2

# Maximum database connections per application process.
# Multiply by the number of replicas before sizing database limits.
DATABASE_POOL_MAX=10

# Maximum time allowed to establish a PostgreSQL connection.
# Must be a positive integer in milliseconds.
DATABASE_CONNECTION_TIMEOUT_MS=10000


# =============================================================================
# S3 OR S3-COMPATIBLE OBJECT STORAGE
# =============================================================================

# AWS region used for request signing and constructed regional public URLs.
# Required for both AWS S3 and local S3-compatible services.
AWS_REGION=ap-south-1

# Optional static credentials.
#
# For local MinIO, enter the credentials configured by that external instance.
# In AWS production, leave them empty to use the SDK default credential chain,
# such as an ECS task role, EC2 instance profile, IRSA, or workload identity.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional temporary credential token. Supply it only with temporary access-key
# credentials; leave empty for MinIO, workload identity, or long-lived local
# development credentials.
AWS_SESSION_TOKEN=

# Required storage locations for public and private files.
# Separate buckets are recommended in production. A shared bucket is allowed
# only when AWS_S3_PUBLIC_PREFIX and AWS_S3_PRIVATE_PREFIX are different.
AWS_S3_PUBLIC_BUCKET=healthcare-public
AWS_S3_PRIVATE_BUCKET=healthcare-private

# Key prefixes inside the configured buckets.
AWS_S3_PUBLIC_PREFIX=public
AWS_S3_PRIVATE_PREFIX=private

# Custom S3-compatible endpoint.
# The example reaches a separately started MinIO instance through its published
# host port from Docker Desktop. Use the storage service's reachable DNS name in
# shared environments. Leave empty for AWS S3.
AWS_S3_ENDPOINT=http://host.docker.internal:9000

# Path-style addressing is normally required for MinIO.
# Use false for standard AWS S3 virtual-hosted-style addressing.
AWS_S3_FORCE_PATH_STYLE=true

# Stable public delivery base URLs. Resolution priority is:
#   1. AWS_CLOUDFRONT_PUBLIC_BASE_URL
#   2. AWS_S3_PUBLIC_BASE_URL
#   3. A URL constructed from the S3 endpoint or AWS region
#
# Do not add a trailing slash.
AWS_CLOUDFRONT_PUBLIC_BASE_URL=
AWS_S3_PUBLIC_BASE_URL=http://localhost:9000/healthcare-public

# Supported server-side encryption values:
#   empty    Do not send an explicit S3 encryption header
#   AES256   S3-managed encryption keys
#   aws:kms  AWS KMS key encryption
#
# Use AES256 or aws:kms in production according to the storage policy.
AWS_S3_SERVER_SIDE_ENCRYPTION=

# Required when AWS_S3_SERVER_SIDE_ENCRYPTION=aws:kms.
# The runtime identity must have permission to use this KMS key.
AWS_S3_KMS_KEY_ID=

# Total number of AWS SDK attempts for retryable storage requests.
# Accepted range: 1 to 10.
AWS_S3_MAX_ATTEMPTS=3

# Maximum time to establish an S3 connection.
# Minimum: 100 milliseconds.
AWS_S3_CONNECTION_TIMEOUT_MS=3000

# Maximum total duration of an S3 request.
# Minimum: 500 milliseconds.
AWS_S3_REQUEST_TIMEOUT_MS=15000


# =============================================================================
# PRESIGNED URL POLICY
# =============================================================================

# Presigned upload URL lifetime.
# Accepted range: 60 to 3600 seconds.
PRESIGNED_UPLOAD_EXPIRY_SECONDS=900

# Private-file presigned download URL lifetime.
# Accepted range: 30 to 3600 seconds.
PRESIGNED_DOWNLOAD_EXPIRY_SECONDS=300


# =============================================================================
# UPLOAD LIMITS AND FILE-TYPE POLICY
# =============================================================================

# Maximum size of one file in bytes. Must be a positive integer.
# Default: 10 MiB.
MAX_SINGLE_FILE_SIZE_BYTES=10485760

# Maximum files accepted in one multipart request.
# Accepted range: 1 to 100.
MAX_MULTIPLE_FILE_COUNT=10

# Maximum combined file size in one multi-file request.
# Must be a positive integer and should not exceed MAX_HTTP_BODY_SIZE_BYTES.
# Default: 50 MiB.
MAX_TOTAL_UPLOAD_SIZE_BYTES=52428800

# Global comma-separated MIME allowlist. Category-specific policies can narrow
# this list but cannot add a MIME type absent here.
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain

# Optional JSON object that overrides maxSizeBytes, mimeTypes, or extensions for
# supported file categories. Category limits cannot exceed the global size and
# MIME limits above. Keep {} to use the application defaults.
UPLOAD_CATEGORY_POLICIES_JSON={}

# One-line example:
# UPLOAD_CATEGORY_POLICIES_JSON={"product_image":{"maxSizeBytes":5242880,"mimeTypes":["image/jpeg","image/png","image/webp"],"extensions":[".jpg",".jpeg",".png",".webp"]}}


# =============================================================================
# IMAGE PROCESSING
# =============================================================================

# Generates WebP thumbnail variants for supported public images.
# Private clinical content is not transformed.
IMAGE_PROCESSING_ENABLED=true

# Thumbnail target width in pixels.
# Accepted range: 64 to 4096.
IMAGE_THUMBNAIL_WIDTH=512

# WebP output quality.
# Accepted range: 1 to 100.
IMAGE_WEBP_QUALITY=82

# Maximum decoded image dimensions used during variant creation.
# Accepted range for each value: 64 to 12000 pixels.
IMAGE_MAX_WIDTH=4096
IMAGE_MAX_HEIGHT=4096


# =============================================================================
# MALWARE SCANNING SAFETY GATE
# =============================================================================

# The included scanner is a development no-op adapter and does not inspect
# files for malware. Production startup is rejected while this value is false.
#
# Replace the no-op provider with a real scanner before production. Setting this
# to true merely acknowledges the risk and permits the current adapter to start;
# it does not make the scanner production-safe.
ALLOW_NOOP_SCANNER_IN_PRODUCTION=false


# =============================================================================
# INTERNAL SERVICE AUTHENTICATION AND TRUSTED HEADERS
# =============================================================================

# Shared secret expected in TRUSTED_GATEWAY_HEADER_NAME.
# An empty value disables this guard and is suitable only for isolated local
# development. Replace this placeholder with a high-entropy secret in every
# shared environment and rotate it through a secret manager.
INTERNAL_SERVICE_SECRET=change-me-for-non-local-environments

# Trusted HTTP header names. Each name must contain only letters, digits, and
# hyphens, and every configured header name must be unique.
TRUSTED_GATEWAY_HEADER_NAME=X-Internal-Service-Key
REQUEST_ID_HEADER_NAME=X-Request-ID
CORRELATION_ID_HEADER_NAME=X-Correlation-ID
USER_ID_HEADER_NAME=X-User-ID
ACTOR_ID_HEADER_NAME=X-Actor-ID
ROLES_HEADER_NAME=X-Roles
IDEMPOTENCY_KEY_HEADER_NAME=Idempotency-Key

# These headers are trusted only when a private gateway strips all incoming
# client values and supplies authenticated replacements. The shared secret
# authenticates the internal hop; authorization policy remains the gateway's
# responsibility.


# =============================================================================
# PRODUCTION CONFIGURATION REQUIREMENTS
# =============================================================================
#
# Recommended values for the current implementation:
#
# NODE_ENV=production
# LOG_LEVEL=info
# SWAGGER_ENABLED=false
# CORS_ENABLED=false
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# AWS_S3_FORCE_PATH_STYLE=false
# AWS_S3_SERVER_SIDE_ENCRYPTION=AES256
#
# Production also requires:
#
# - A non-placeholder DATABASE_URL injected from a secret manager
# - A least-privilege runtime database role without DDL/migration ownership
# - Database pool limits sized across all replicas
# - Workload-identity credentials instead of static AWS keys where available
# - Private bucket access and explicit public bucket/CloudFront policy
# - A non-placeholder INTERNAL_SERVICE_SECRET
# - A trusted, header-sanitizing gateway with direct client access blocked
# - A real malware-scanning provider replacing the no-op adapter
# - Explicit CORS origins if browser access is enabled
# - ALLOW_NOOP_SCANNER_IN_PRODUCTION=true only as a temporary, explicitly
#   accepted risk while the development no-op adapter is still installed
