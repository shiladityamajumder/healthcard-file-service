NODE_ENV=development
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-local-secret
PORT=3000
PROJECT_NAME=Healthcare File Service
APP_VERSION=1.0.0
API_PREFIX=api
API_VERSION=v1
LOG_LEVEL=info

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=healthcare
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_S3_PUBLIC_BUCKET=healthcare-public
AWS_S3_PRIVATE_BUCKET=healthcare-private
AWS_S3_PUBLIC_PREFIX=public
AWS_S3_PRIVATE_PREFIX=private
AWS_S3_ENDPOINT=http://minio:9000
AWS_S3_FORCE_PATH_STYLE=true
AWS_CLOUDFRONT_PUBLIC_BASE_URL=
AWS_S3_PUBLIC_BASE_URL=http://localhost:9000/healthcare-public
AWS_S3_SERVER_SIDE_ENCRYPTION=
AWS_S3_KMS_KEY_ID=
AWS_S3_MAX_ATTEMPTS=3
AWS_S3_CONNECTION_TIMEOUT_MS=3000
AWS_S3_REQUEST_TIMEOUT_MS=15000

PRESIGNED_UPLOAD_EXPIRY_SECONDS=900
PRESIGNED_DOWNLOAD_EXPIRY_SECONDS=300
MAX_SINGLE_FILE_SIZE_BYTES=10485760
MAX_MULTIPLE_FILE_COUNT=10
MAX_TOTAL_UPLOAD_SIZE_BYTES=52428800
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain
UPLOAD_CATEGORY_POLICIES_JSON={}
IMAGE_PROCESSING_ENABLED=true
IMAGE_THUMBNAIL_WIDTH=512
IMAGE_WEBP_QUALITY=82
IMAGE_MAX_WIDTH=4096
IMAGE_MAX_HEIGHT=4096
ALLOW_NOOP_SCANNER_IN_PRODUCTION=false

INTERNAL_SERVICE_SECRET=change-me-for-non-local-environments
TRUSTED_GATEWAY_HEADER_NAME=x-internal-service-key
REQUEST_ID_HEADER_NAME=x-request-id
CORRELATION_ID_HEADER_NAME=x-correlation-id
USER_ID_HEADER_NAME=x-user-id
ACTOR_ID_HEADER_NAME=x-actor-id
ROLES_HEADER_NAME=x-roles
IDEMPOTENCY_KEY_HEADER_NAME=idempotency-key

CORS_ENABLED=false
CORS_ORIGINS=
SWAGGER_ENABLED=true
MAX_HTTP_BODY_SIZE_BYTES=62914560
